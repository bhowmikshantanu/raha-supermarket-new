{
  "expo": {
    "name": "Raha Supermarket",
    "slug": "rahasupermarket",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rahasupermarket",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.rahasupermarket.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#7A1F3D"
      },
      "edgeToEdgeEnabled": true,
      "package": "in.rahasupermarket.app",
      "versionCode": 9,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#F28C28",
          "defaultChannel": "orders"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/proxy/8081"
    },
    "extra": {
      "eas": {
        "projectId": "a05e8ce6-60d4-411b-8af9-0203a50665a3"
      }
    },
    "androidNavigationBar": {
      "backgroundColor": "#FFF9F2",
      "barStyle": "dark-content",
      "enforceContrast": false
    }
  }
}
