{
  "expo": {
    "name": "Raha Supermarket",
    "slug": "rahasupermarket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rahasupermarket",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.localgroceryapp.g49uwf"
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#16A34A"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.localgroceryapp.g49uwf",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json"
    },

    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#16A34A",
          "defaultChannel": "orders"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/proxy/8081"
    },

    "extra": {
      "eas": {
        "projectId": "a05e8ce6-60d4-411b-8af9-0203a50665a3"
      }
    }
  }
}